LLM_PROVIDER=openai
LLM_PROVIDER_CHAIN=openai,ollama

OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.4-nano
OPENAI_TIMEOUT_SEC=30
OPENAI_MAX_TOKENS=1200
OPENAI_TEMPERATURE=0.1
OPENAI_MAX_REPAIR_ATTEMPTS=1
OPENAI_DAILY_REQUEST_LIMIT=30

OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.1:8b
OLLAMA_TIMEOUT_SEC=180
OLLAMA_MAX_TOKENS=1200
OLLAMA_TEMPERATURE=0.1

LLM_ALLOW_OPENAI_FALLBACK=true
LLM_MAX_TOTAL_ATTEMPTS=3

SCENARIO_EPISODE_DEFAULT_COUNT=5
SCENARIO_EPISODE_MAX_COUNT=200
RUN_QUEUE_EXPORT_BASE_DIR=data/run_queue_exports
