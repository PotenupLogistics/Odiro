# Normalize text to LF in the index and checkout.
* text=auto eol=lf

# Unix-style scripts and hooks must stay LF.
*.sh text eol=lf
*.bash text eol=lf
.githooks/* text eol=lf

# Unreal and binary assets.
[attr]ue-lock -diff -merge -text -eol lockable

*.uasset ue-lock
*.umap ue-lock
*.ubulk ue-lock
*.uexp ue-lock
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.ico binary
*.pdf binary
*.zip binary
*.7z binary
