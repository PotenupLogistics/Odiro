#!/bin/sh

message_file=$1
allowed_types="feat fix refactor test spec plan docs asset build ci chore"
recommended_scopes="client bridge agents contract tool docs ui sample git"
cr=$(printf '\r')

print_help() {
  cat >&2 <<'EOF'
Invalid commit message.

Expected:
  <type>: <imperative summary>
  <type>(<scope>): <imperative summary>

Allowed types:
  feat, fix, refactor, test, spec, plan, docs, asset, build, ci, chore

Recommended scopes:
  client, bridge, agents, contract, tool, docs, ui, sample, git

Rules:
  - subject must be 72 characters or less
  - subject must not end with a period
  - body, if present, must start after one blank line
  - scope, if present, must be lowercase kebab-case
  - unknown scopes warn but do not block commits

Examples:
  docs: define project file naming rules
  chore(git): enforce commit message format
  spec(contract): define episode setup schema
  asset(sample): add default pathfinding policy
  refactor(docs): move migration procedure into plan
EOF
}

fail() {
  echo "commit-msg: $1" >&2
  echo >&2
  print_help
  exit 1
}

contains_word() {
  case " $1 " in
    *" $2 "*) return 0 ;;
    *) return 1 ;;
  esac
}

is_lower_letters() {
  case "$1" in
    ""|*[!abcdefghijklmnopqrstuvwxyz]*) return 1 ;;
    *) return 0 ;;
  esac
}

is_kebab_segment() {
  case "$1" in
    ""|-*|*-|*--*|*[!abcdefghijklmnopqrstuvwxyz0123456789-]*)
      return 1
      ;;
    *)
      return 0
      ;;
  esac
}

has_token() {
  token_pattern=$1
  text=$2

  case "$text" in
    $token_pattern|$token_pattern[[:space:]]*|*[[:space:]:]$token_pattern|*[[:space:]:]$token_pattern[[:space:]]*)
      return 0
      ;;
    *)
      return 1
      ;;
  esac
}

has_blocked_token() {
  has_token '[Ww][Ii][Pp]' "$1" ||
    has_token '[Tt][Oo][Dd][Oo]' "$1" ||
    has_token '[Tt][Mm][Pp]' "$1"
}

if [ -z "$message_file" ] || [ ! -f "$message_file" ]; then
  fail "message file is missing"
fi

subject=
second_line=
line_count=0

while IFS= read -r line || [ -n "$line" ]; do
  line=${line%"$cr"}
  case "$line" in
    \#*) continue ;;
  esac

  line_count=$((line_count + 1))
  if [ "$line_count" -eq 1 ]; then
    subject=$line
  elif [ "$line_count" -eq 2 ]; then
    second_line=$line
  fi
done < "$message_file"

if [ -z "$subject" ]; then
  fail "subject is empty"
fi

case "$subject" in
  Merge\ *|Revert\ \"*)
    exit 0
    ;;
esac

case "$subject" in
  *": "*)
    ;;
  *)
    fail "subject must match '<type>: <summary>' or '<type>(<scope>): <summary>'"
    ;;
esac

header=${subject%%: *}
summary=${subject#*: }

case "$summary" in
  ""|[[:space:]]*)
    fail "subject must match '<type>: <summary>' or '<type>(<scope>): <summary>'"
    ;;
esac

scope=
case "$header" in
  *"("*")")
    type=${header%%(*}
    prefix="$type("
    scope=${header#"$prefix"}
    scope=${scope%)}
    ;;
  *"("*|*")"*)
    fail "subject must match '<type>: <summary>' or '<type>(<scope>): <summary>'"
    ;;
  *)
    type=$header
    ;;
esac

if ! is_lower_letters "$type"; then
  fail "subject must match '<type>: <summary>' or '<type>(<scope>): <summary>'"
fi

if ! contains_word "$allowed_types" "$type"; then
  fail "subject must match '<type>: <summary>' or '<type>(<scope>): <summary>'"
fi

if [ -n "$scope" ]; then
  if ! is_kebab_segment "$scope"; then
    fail "subject must match '<type>: <summary>' or '<type>(<scope>): <summary>'"
  fi

  if ! contains_word "$recommended_scopes" "$scope"; then
    echo "commit-msg: warning: unknown scope '$scope'" >&2
    echo "commit-msg: recommended scopes: $recommended_scopes" >&2
  fi
fi

if [ "${#subject}" -gt 72 ]; then
  fail "subject is longer than 72 characters"
fi

case "$subject" in
  *.)
    fail "subject must not end with a period"
    ;;
esac

if has_blocked_token "$subject"; then
  fail "subject must not contain WIP, TODO, or TMP"
fi

if [ "$line_count" -gt 1 ] && [ -n "$second_line" ]; then
  fail "body must be separated from subject by a blank line"
fi

exit 0
