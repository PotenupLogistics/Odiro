#!/bin/sh

repo_root=$(git rev-parse --show-toplevel) || exit 1
install_script="$repo_root/tools/install.ps1"

if [ ! -f "$install_script" ]; then
  printf >&2 "\n%s\n\n" "Repository install script was not found: $install_script"
  exit 2
fi

if command -v powershell.exe >/dev/null 2>&1; then
  powershell.exe -NoProfile -ExecutionPolicy Bypass -File "$install_script"
elif command -v powershell >/dev/null 2>&1; then
  powershell -NoProfile -ExecutionPolicy Bypass -File "$install_script"
elif command -v pwsh >/dev/null 2>&1; then
  pwsh -NoProfile -File "$install_script"
else
  printf >&2 "\n%s\n\n" "PowerShell was not found on PATH; cannot run tools/install.ps1."
  exit 2
fi
