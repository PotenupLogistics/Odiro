#!/bin/sh

repo_root=$(git rev-parse --show-toplevel 2>/dev/null)
if [ -z "$repo_root" ]; then
  echo "pre-merge-commit: not inside a Git repository" >&2
  exit 1
fi

current_branch=$(git symbolic-ref --quiet --short HEAD 2>/dev/null)
if [ "$current_branch" = "main" ]; then
  echo "main-workflow: local merges into main are blocked; merge through PR." >&2
  exit 1
fi

powershell.exe -NoProfile -ExecutionPolicy Bypass -File "$repo_root/tools/verify-staged.ps1" -Hook pre-merge-commit
exit $?
