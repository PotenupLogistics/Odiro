# OpenAI 호출 예시 설정이며, 실제 실행 전 개인 OPENAI_API_KEY 설정 필요.
# 실제 키는 로컬 .env에만 넣고 커밋하지 않는다.
LLM_PROVIDER=openai
# v2 안정성 fallback은 provider 재시도가 아니라 내부 rule-based/deterministic 처리다.
LLM_PROVIDER_CHAIN=openai

OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.4-nano
OPENAI_TIMEOUT_SEC=30
OPENAI_MAX_TOKENS=1200
OPENAI_TEMPERATURE=0.1
OPENAI_MAX_REPAIR_ATTEMPTS=1
OPENAI_DAILY_REQUEST_LIMIT=30

PDF_RAG_EMBEDDING_MODEL=text-embedding-3-small
PDF_RAG_QUERY_TIMEOUT_SEC=5
PDF_RAG_QUERY_MAX_RETRIES=1
PDF_RAG_VALIDATED_CORPUS_PATH=data/rag/pdf_corpus/validated_parent_child_chunks.jsonl
PDF_RAG_CHROMA_DIR=.cache/rag/chroma/pdf_corpus
# task-setup.bat 기본 흐름에서 PDF RAG Chroma index 준비를 건너뛰려면 1로 설정한다.
ODIRO_SKIP_PDF_RAG_INDEX=
# PDF RAG Chroma index 준비 실패를 setup 실패로 처리하려면 1로 설정한다.
ODIRO_REQUIRE_PDF_RAG_INDEX=

OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.1:8b
OLLAMA_TIMEOUT_SEC=180
OLLAMA_MAX_TOKENS=1200
OLLAMA_TEMPERATURE=0.1

LLM_MAX_TOTAL_ATTEMPTS=3

SCENARIO_EPISODE_DEFAULT_COUNT=5
SCENARIO_EPISODE_MAX_COUNT=200
RUN_QUEUE_EXPORT_BASE_DIR=data/run_queue_exports
SCENARIO_ARTIFACT_OUTPUT_DIR=data/run_queue_exports
SCENARIO_ARTIFACT_WRITE_ENABLED=true
V2_AGENT_LLM_ENABLED=true
V2_AGENT_LLM_REPAIR_ENABLED=true
V2_AGENT_LLM_MAX_REPAIR_ATTEMPTS=1
