{
  "schema": "delivery_bot_setup",
  "version": 1,
  "robot": {
    "drive": {
      "max_speed_kmh": 7.0,
      "slowdown_speed_range_kmh": 5.0,
      "speed_limit_brake": 0.06,
      "stop_brake_input": 0.18,
      "throttle_input_rate_per_second": 0.28,
      "brake_input_rate_per_second": 0.35,
      "steering_input_rate_per_second": 3.2,
      "acceleration_rate_kmh_per_second": 1.2,
      "deceleration_rate_kmh_per_second": 0.9,
      "use_handbrake_when_brake": false
    },
    "lidar": {
      "lidar_mode": "3d",
      "draw_debug": false,
      "angle_step_degree": 3.0,
      "vertical_min_degree": -25.0,
      "vertical_max_degree": 25.0,
      "vertical_step_degree": 5,
      "scan_rate_hz": 5.0,
      "scan_range_m": 15.0,
      "front_half_angle_degree": 50.0,
      "stop_distance_m": 2.0,
      "obstacle_warning_distance_m": 5.2,
      "slow_down_distance_m": 8.0,
      "observation_profile": "quality_point_cloud",
      "point_cloud": {
        "capture_enabled": true,
        "capture_every_n_sensor_frames": 5,
        "range_limit_m": 15.0,
        "include_ground_points": true,
        "max_points": 12000
      }
    }
  }
}
