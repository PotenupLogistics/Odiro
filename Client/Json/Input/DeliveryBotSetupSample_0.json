{
  "schema": "delivery_bot_setup",
  "version": 1,
  "robot": {
    "drive": {
      "max_speed_kmh": 10.0,
      "slowdown_speed_range_kmh": 4.0,
      "stop_brake_input": 1.0,
      "brake_input_rate_per_second": 5.0,
      "steering_input_rate_per_second": 3.2,
      "use_handbrake_when_brake": true
    },
    "lidar": {
      "scan_range_m": 5.0,
      "angle_step_degree": 5.0,
      "scan_rate_hz": 2.0,
      "stop_distance_m": 0.5,
      "obstacle_warning_distance_m": 2.5,
      "slow_down_distance_m": 3.5
    }
  }
}
