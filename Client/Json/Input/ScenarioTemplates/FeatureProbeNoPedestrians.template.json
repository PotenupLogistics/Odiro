        "count": 2,
        "gap_width_m": {
          "min": 1.2,
          "max": 1.5
        },
        "yaw_deg": 0.0,
        "allow_blocking": false
      },
      {
        "id": "building_entry_curb_line",
        "kind": "pattern",
        "pattern": "line",
        "prop": "obstacle.road_cone_01",
        "at": {
          "segment": "building_entry",
          "along_m": 8.5,
          "offset_m": 0.1,
          "lane": "curb_edge"
        },
        "count": {
          "min": 3,
          "max": 5
        },
        "spacing_m": 0.9,
        "yaw_deg": {
          "min": 0.0,
          "max": 15.0
        },
        "allow_blocking": false
      },
      {
        "id": "exit_edge_clutter",
        "kind": "scatter",
        "zone": {
          "segments": ["exit"],
          "lanes": ["building_edge", "curb_edge"]
        },
        "density_per_10m": {
          "min": 1.0,
          "max": 2.0
        },
        "count": {
          "min": 1,
          "max": 4
        },
        "palette": {
          "categories": ["street_furniture", "utility"],
          "classes": ["blocking"]
        },
        "allow_blocking": false
      },
      {
        "id": "surface_object_noise",
        "kind": "scatter",
        "zone": {
          "segments": ["entry", "building_entry"],
          "lanes": ["center"]
        },
        "density_per_10m": {
          "min": 0.0,
          "max": 1.0
        },
        "palette": {
          "categories": ["surface_object"],
          "classes": ["traversable_cost"]
        },
        "allow_blocking": false
      }
    ]
  },
  "pedestrians": {
    "background": {
      "count": 0,
      "speed_mps": 0.0
    },
    "encounters": []
  },
  "robot": {
    "start": {
      "type": "corridor_pose",
      "segment": "entry",
      "along_m": {
        "min": 0.5,
        "max": 1.0
      },
      "offset_m": {
        "min": -0.1,
        "max": 0.1
      },
      "lane": "center",
      "heading": "forward"
    },
    "goal": {
      "type": "exit",
      "heading": "auto"
    }
  }
}
