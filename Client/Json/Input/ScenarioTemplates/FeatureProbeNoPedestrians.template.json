{
  "schema": "scenario_template",
  "version": 1,
  "template_id": "feature_probe_no_pedestrians",
  "intent": "Exercise corridor layout, surface lanes, static obstacle placement kinds, sampled values, and robot anchors without adding pedestrians.",
  "corridor": {
    "axis": {
      "type": "polyline",
      "points_m": [
        [0.0, 0.0],
        [8.0, 0.0],
        [16.0, 2.0],
        [26.0, 2.0],
        [34.0, 0.0]
      ]
    },
    "walkway_width_m": {
      "min": 2.6,
      "max": 3.2
    },
    "building_side": [
      {
        "surface": "wall",
        "width_m": 0.4
      },
      {
        "surface": "building",
        "width_m": {
          "min": 0.8,
          "max": 1.2
        }
      }
    ],
    "curb_side": [
      {
        "surface": "grass",
        "width_m": {
          "min": 0.4,
          "max": 0.8
        }
      },
      {
        "surface": "road",
        "width_m": 3.0
      }
    ],
    "segments": [
      {
        "id": "entry",
        "type": "straight",
        "along_range_m": [0.0, 6.0]
      },
      {
        "id": "building_entry",
        "type": "entrance",
        "along_range_m": [6.0, 11.0],
        "replaced_by": "driveway"
      },
      {
        "id": "pinch",
        "type": "narrowing",
        "along_range_m": [11.0, 17.0],
        "replaced_by": {
          "choices": ["grass", "road"]
        }
      },
      {
        "id": "crosswalk",
        "type": "crosswalk",
        "along_range_m": [17.0, 23.0],
        "replaced_by": "crosswalk_stripe"
      },
      {
        "id": "exit",
        "type": "straight",
        "along_range_m": [23.0, 34.0]
      }
    ]
  },
  "obstacles": {
    "min_clear_width_m": 1.05,
    "placements": [
      {
        "id": "entry_curb_cone",
        "kind": "fixed",
        "prop": "obstacle.road_cone_01",
        "at": {
          "segment": "entry",
          "along_m": {
            "min": 2.5,
            "max": 4.0
          },
          "offset_m": 0.15,
          "lane": "curb_edge"
        },
        "yaw_deg": {
          "min": -10.0,
          "max": 10.0
        },
        "allow_blocking": false
      },
      {
        "id": "pinch_building_cone",
        "kind": "fixed",
        "prop": "obstacle.road_cone_01",
        "at": {
          "segment": "pinch",
          "along_m": 13.25,
          "offset_m": -0.2,
          "lane": "building_edge"
        },
        "yaw_deg": 90.0,
        "allow_blocking": false
      },
      {
        "id": "crosswalk_gate",
        "kind": "pattern",
        "pattern": "gate",
        "prop": "obstacle.road_cone_01",
        "at": {
          "segment": "crosswalk",
          "along_m": {
            "min": 18.0,
            "max": 21.0
          },
          "offset_m": 0.0,
          "lane": "across"
