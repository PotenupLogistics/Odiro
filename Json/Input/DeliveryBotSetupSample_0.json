      "max_steering": 0.5,
      "max_steering_delta": 0.09,
      "obstacle_slow_speed_kmh": 2.0
    },
    "lidar": {
      "scan_range_m": 5.0,
      "angle_step_degree": 5.0,
      "stop_distance_m": 0.5,
      "near_miss_distance_m": 1.0,
      "slow_down_distance_m": 3.5
    }
  }
