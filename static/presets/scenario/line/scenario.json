{
  "schema": "scenario",
  "version": 1,
  "scenario_id": "demo_sidewalk_obstacle",
  "intent": "Check whether the demo policy can move through a short sidewalk with one curb-side obstacle.",
  "corridor": {
    "axis": {
      "type": "polyline",
      "points_m": [[0.0, 0.0], [4.0, 0.0]]
    },
    "walkway_width_m": { "min": 2.8, "max": 3.4 },
    "segments": [
      {
        "id": "main",
        "type": "straight",
        "along_range_m": [0.0, 4.0]
      }
    ],
    "building_side": [
      {
        "surface": "building",
        "width_m": 0.5
      }
    ],
    "curb_side": [
      {
        "surface": "road",
        "width_m": 2.0
      }
    ]
  },
  "obstacles": {
    "min_clear_width_m": 0.9,
    "placements": [
      {
        "kind": "fixed",
        "id": "curb_marker",
        "prop": "obstacle.road_cone_01",
        "at": {
          "segment": "main",
          "along_m": 2.0,
          "offset_m": -1.0,
          "lane": "curb_edge"
        },
        "yaw_deg": 0.0
      }
    ]
  },
  "pedestrians": {
    "background": {
      "count": 0
    },
    "encounters": []
  },
  "robot": {
    "start": {
      "type": "corridor_pose",
      "segment": "main",
      "along_m": 0.5,
      "offset_m": 0.0,
      "heading": "forward"
    },
    "goal": {
      "type": "corridor_pose",
      "segment": "main",
      "along_m": 3.5,
      "offset_m": 0.0,
      "heading": "forward"
    }
  }
}
