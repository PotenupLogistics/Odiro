        "length_m": 6.0,
        "walkway_width_m": { "min": 2.2, "max": 2.8 },
        "along_range_m": [8.0, 14.0]
      }
    ],
    "building_side": [
      {
        "surface": "wall",
        "width_m": 0.5
      }
    ],
    "curb_side": [
      {
        "surface": "grass",
        "width_m": { "min": 0.4, "max": 0.8 }
